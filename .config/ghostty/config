# ──────────────────────────────────────────────
# Font
# ──────────────────────────────────────────────
font-family = "JetBrainsMono Nerd Font"
font-size = 13
font-feature = +liga
font-feature = +calt

# ──────────────────────────────────────────────
# Theme — Catppuccin Macchiato
# ──────────────────────────────────────────────
background = #24273a
foreground = #cad3f5

# Normal colors
palette = 0=#494d64
palette = 1=#ed8796
palette = 2=#a6da95
palette = 3=#eed49f
palette = 4=#8aadf4
palette = 5=#f5bde6
palette = 6=#8bd5ca
palette = 7=#b8c0e0

# Bright colors
palette = 8=#5b6078
palette = 9=#ed8796
palette = 10=#a6da95
palette = 11=#eed49f
palette = 12=#8aadf4
palette = 13=#f5bde6
palette = 14=#8bd5ca
palette = 15=#a5adcb

selection-background = #363a4f
selection-foreground = #cad3f5

# Cursor
cursor-color = #f4dbd6
cursor-text = #24273a

# ──────────────────────────────────────────────
# Window
# ──────────────────────────────────────────────
window-padding-x = 10
window-padding-y = 10
window-height = 40
window-width = 160
window-save-state = always

# ──────────────────────────────────────────────
# Cursor
# ──────────────────────────────────────────────
cursor-style = block
cursor-style-blink = false

# ──────────────────────────────────────────────
# Shell integration
# ──────────────────────────────────────────────
shell-integration = detect
shell-integration-features = cursor,sudo,title

# ──────────────────────────────────────────────
# macOS
# ──────────────────────────────────────────────
macos-option-as-alt = true

# ──────────────────────────────────────────────
# Scrollback & mouse
# ──────────────────────────────────────────────
scrollback-limit = 10000
mouse-hide-while-typing = true

# ──────────────────────────────────────────────
# Keybindings
# ──────────────────────────────────────────────

# Ctrl+Cmd acts as tmux prefix (C-Space)
keybind = ctrl+super=send_key:ctrl+space


# Notifications

confirm-close-surface = false